---
import { careCategories, getAppointmentUrl } from '../data/care';
---

<section class="care-section" id="opcoes-de-cuidados" aria-labelledby="care-title">
  <h2 id="care-title">Do que você quer cuidar?</h2>

  <div class="care-panels">
    {careCategories.map((category, index) => (
      <div
        class="care-panel"
        id={`care-panel-${category.value}`}
        data-care-panel={category.value}
        role="group"
        aria-label={`Cuidados ${category.adjective}`}
        hidden={index !== 0}
      >
        {category.services.map((service) => (
          <article class="care-item">
            <h3>{service.title}</h3>
            <p>{service.description}</p>
          </article>
        ))}
      </div>
    ))}
  </div>

  <div class="care-action">
    <a
      class="appointment-button"
      href={getAppointmentUrl('facial')}
      data-appointment-link
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Agendar avaliação facial pelo WhatsApp (abre em outra aba)"
    >
      <span>Agendar avaliação</span>
      <span class="button-arrow" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none"><path d="M5 19 19 5M5 5h14v14" /></svg>
        <svg viewBox="0 0 24 24" fill="none"><path d="M5 19 19 5M5 5h14v14" /></svg>
      </span>
    </a>
  </div>
</section>

<style>
  .care-section {
    padding-block: clamp(64px, 7.5vw, 112px) clamp(72px, 8vw, 120px);
    font-family: 'Instrument Sans', 'Manrope', Arial, sans-serif;
  }

  h2 {
    margin: 0;
    font-size: clamp(30px, 3.1vw, 44px);
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }

  .care-panels { margin-top: clamp(48px, 6vw, 88px); }

  .care-panel {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(28px, 5vw, 76px);
    min-height: 150px;
  }

  .care-panel[hidden] { display: none; }
  .care-item { min-width: 0; }

  h3 {
    margin: 0 0 14px;
    color: var(--olive);
    font-size: clamp(24px, 2.25vw, 32px);
    font-weight: 500;
    line-height: 1.25;
    letter-spacing: -0.035em;
  }

  p {
    max-width: 27ch;
    margin: 0;
    font-size: clamp(17px, 1.5vw, 21px);
    font-weight: 400;
    line-height: 1.5;
    letter-spacing: -0.015em;
  }

  .care-action {
    display: flex;
    justify-content: flex-end;
    margin-top: clamp(44px, 5.6vw, 80px);
    padding-top: clamp(28px, 3.8vw, 54px);
    border-top: 1px solid var(--rose);
  }

  @media (max-width: 700px) {
    .care-section { padding-block: 40px 56px; }
    h2 { max-width: 16ch; font-size: 32px; }
    .care-panels { margin-top: 36px; }
    .care-panel { grid-template-columns: 1fr; gap: 32px; min-height: 348px; }
    h3 { margin-bottom: 8px; font-size: 26px; }
    p { max-width: 28ch; font-size: 18px; }
    .care-action { margin-top: 36px; padding-top: 32px; }
    .care-action .appointment-button { width: 100%; }
  }

  @media (max-width: 370px) {
    h2 { font-size: 30px; }
    h3 { font-size: 24px; }
    .care-panel { min-height: 376px; }
  }
</style>
